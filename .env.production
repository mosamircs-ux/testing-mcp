# Production Environment Configuration
NODE_ENV=production
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=/api/v1

# Database
POSTGRES_DB=novaqa_production
POSTGRES_USER=novaqa_admin
POSTGRES_PASSWORD=novaqa_secure_db_pass_2026
DATABASE_URL=postgresql://novaqa_admin:novaqa_secure_db_pass_2026@postgres:5432/novaqa_production?schema=public

# Redis
REDIS_PASSWORD=novaqa_secure_redis_pass_2026
REDIS_URL=redis://:novaqa_secure_redis_pass_2026@redis:6379/0

# Security & JWT
JWT_SECRET=novaqa_super_secure_production_jwt_secret_key_2026_x89a_99b7c2f
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d

# Object Storage (MinIO)
STORAGE_ENDPOINT=http://minio:9000
STORAGE_BUCKET=novaqa-artifacts
STORAGE_ACCESS_KEY=novaqa_minio_root
STORAGE_SECRET_KEY=novaqa_minio_secret_key_2026

# Paymob
PAYMOB_API_KEY=mock_paymob_api_key
PAYMOB_SECRET_KEY=mock_paymob_secret_key
PAYMOB_HMAC_SECRET=mock_paymob_hmac_secret_sha512
PAYMOB_INTEGRATION_ID_CARD=123456
PAYMOB_PUBLIC_KEY=mock_paymob_public_key

# AI Engine
AI_DEFAULT_PROVIDER=mock
MAX_CONCURRENT_RUNS=8
WORKER_PORT=4001

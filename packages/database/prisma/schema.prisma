datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                       String               @id @default(cuid())
  email                    String               @unique
  name                     String
  passwordHash             String
  avatarUrl                String?
  isEmailVerified          Boolean              @default(false)
  emailVerificationToken   String?
  emailVerificationExpires DateTime?
  resetPasswordToken       String?
  resetPasswordExpires     DateTime?
  oauthProvider            String?
  oauthId                  String?
  sessions                 Session[]
  memberships              OrganizationMember[]
  teamMembers              TeamMember[]
  apiKeys                  ApiKey[]
  testRuns                 TestRun[]
  auditLogs                AuditLog[]
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
}

model Session {
  id               String   @id @default(cuid())
  userId           String
  refreshTokenHash String   @unique
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  isRevoked        Boolean  @default(false)
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Organization {
  id             String               @id @default(cuid())
  name           String
  slug           String               @unique
  tier           String               @default("FREE")
  status         String               @default("ACTIVE") // ACTIVE, SUSPENDED
  members        OrganizationMember[]
  teams          Team[]
  projects       Project[]
  apiKeys        ApiKey[]
  auditLogs      AuditLog[]
  subscription   Subscription?
  usageMetrics   UsageMetric[]
  invoices       Invoice[]
  payments       Payment[]
  paymentMethods PaymentMethod[]
  transactions   Transaction[]
  credits        Credit[]
  refunds        Refund[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  role           String       @default("QA_ENGINEER")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([organizationId, userId])
}

model Team {
  id             String        @id @default(cuid())
  organizationId String
  name           String
  slug           String
  description    String?
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members        TeamMember[]
  projects       Project[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @default(now()) @updatedAt

  @@unique([organizationId, slug])
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  role      String   @default("MEMBER")
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([teamId, userId])
}

model Project {
  id                 String             @id @default(cuid())
  organizationId     String
  teamId             String?
  name               String
  slug               String
  description        String?
  category           String             @default("WEB")
  engineType         String             @default("PLAYWRIGHT")
  repositoryUrl      String?
  baseUrl            String?
  specUrl            String?
  appUrl             String?
  authConfig         String             @default("{}")
  repoConfig         String             @default("{}")
  testingPreferences String             @default("{}")
  prdContent         String?
  settings           String             @default("{}")
  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  team               Team?              @relation(fields: [teamId], references: [id], onDelete: SetNull)
  environments       Environment[]
  testSuites         TestSuite[]
  testRuns           TestRun[]
  findings           Finding[]
  apiKeys            ApiKey[]
  discoveries        ProjectDiscovery[]
  testPlans          TestPlan[]
  plannedTestCases   PlannedTestCase[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@unique([organizationId, slug])
}

model ProjectDiscovery {
  id             String    @id @default(cuid())
  projectId      String
  status         String    @default("PENDING")
  progress       Int       @default(0)
  currentStep    String    @default("INITIALIZING")
  durationMs     Int       @default(0)
  logs           String    @default("[]")
  techStack      String    @default("{}")
  applicationMap String    @default("{}")
  routesMap      String    @default("[]")
  apiMap         String    @default("[]")
  authMap        String    @default("{}")
  featureMap     String    @default("[]")
  roleMap        String    @default("[]")
  workflowMap    String    @default("[]")
  riskAreas      String    @default("[]")
  rawAnalysis    String    @default("{}")
  errorMessage   String?
  routes         String    @default("[]")
  apiEndpoints   String    @default("[]")
  authMechanism  String    @default("{}")
  workflows      String    @default("[]")
  normalizedSpec String?
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model TestPlan {
  id               String            @id @default(cuid())
  projectId        String
  title            String
  description      String?
  version          String            @default("1.0.0")
  status           String            @default("GENERATING")
  summary          String?
  coverageMetrics  String            @default("{}")
  userInstructions String?
  project          Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  testCases        PlannedTestCase[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([projectId, createdAt])
}

model PlannedTestCase {
  id                   String   @id @default(cuid())
  customId             String
  testPlanId           String
  projectId            String
  title                String
  description          String
  priority             String   @default("HIGH")
  category             String   @default("Functional")
  scenarioType         String   @default("HAPPY_PATH")
  preconditions        String   @default("[]")
  testData             String   @default("{}")
  steps                String   @default("[]")
  expectedResults      String
  risk                 String   @default("")
  requirementReference String   @default("")
  affectedRoutes       String   @default("[]")
  affectedApis         String   @default("[]")
  roles                String   @default("[]")
  environment          String   @default("STAGING")
  automationStatus     String   @default("READY_FOR_AUTOMATION")
  reviewStatus         String   @default("PENDING")
  tags                 String   @default("[]")
  groupName            String   @default("General")
  semanticHash         String?
  testPlan             TestPlan @relation(fields: [testPlanId], references: [id], onDelete: Cascade)
  project              Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([testPlanId, customId])
}

model Environment {
  id        String    @id @default(cuid())
  projectId String
  name      String
  slug      String
  baseUrl   String
  variables String    @default("{}")
  headers   String    @default("{}")
  isDefault Boolean   @default(false)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  testRuns  TestRun[]
  createdAt DateTime  @default(now())

  @@unique([projectId, slug])
}

model TestSuite {
  id           String     @id @default(cuid())
  projectId    String
  name         String
  description  String?
  tags         String     @default("[]")
  cronSchedule String?
  isActive     Boolean    @default(true)
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  testCases    TestCase[]
  testRuns     TestRun[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model TestCase {
  id              String         @id @default(cuid())
  suiteId         String
  title           String
  description     String?
  category        String         @default("functional")
  priority        String         @default("MEDIUM")
  expectedResult  String
  codeSnippet     String?
  isFlaky         Boolean        @default(false)
  flakinessScore  Float          @default(0.0)
  autoHealEnabled Boolean        @default(true)
  suite           TestSuite      @relation(fields: [suiteId], references: [id], onDelete: Cascade)
  steps           TestCaseStep[]
  results         TestResult[]
  selfHealLogs    SelfHealLog[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([suiteId])
}

model TestCaseStep {
  id             String   @id @default(cuid())
  testCaseId     String
  order          Int
  action         String
  target         String?
  value          String?
  description    String
  expectedOutput String?
  testCase       TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@index([testCaseId, order])
}

model TestRun {
  id            String        @id @default(cuid())
  projectId     String
  suiteId       String?
  environmentId String
  triggeredById String?
  triggerSource String        @default("MANUAL")
  status        String        @default("PENDING")
  totalTests    Int           @default(0)
  passedTests   Int           @default(0)
  failedTests   Int           @default(0)
  skippedTests  Int           @default(0)
  durationMs    Int           @default(0)
  startedAt     DateTime?
  completedAt   DateTime?
  project       Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  suite         TestSuite?    @relation(fields: [suiteId], references: [id], onDelete: SetNull)
  environment   Environment   @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  triggeredBy   User?         @relation(fields: [triggeredById], references: [id], onDelete: SetNull)
  results       TestResult[]
  artifacts     Artifact[]
  findings      Finding[]
  createdAt     DateTime      @default(now())

  @@index([projectId, createdAt])
  @@index([status])
}

model TestResult {
  id           String        @id @default(cuid())
  testRunId    String
  testCaseId   String
  status       String
  durationMs   Int           @default(0)
  startedAt    DateTime?
  completedAt  DateTime?
  stepResults  String        @default("[]")
  errorMessage String?
  stackTrace   String?
  stdout       String?
  stderr       String?
  retryCount   Int           @default(0)
  isFlaky      Boolean       @default(false)
  testRun      TestRun       @relation(fields: [testRunId], references: [id], onDelete: Cascade)
  testCase     TestCase      @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  artifacts    Artifact[]
  findings     Finding[]
  selfHealLogs SelfHealLog[]
  createdAt    DateTime      @default(now())

  @@index([testRunId, status])
}

model Finding {
  id                 String      @id @default(cuid())
  testRunId          String?
  testResultId       String?
  projectId          String
  category           String
  severity           String
  status             String      @default("OPEN")
  title              String
  description        String
  rootCauseAnalysis  String?
  suggestedFix       String?
  suggestedPatch     String?
  autoHealSelector   String?
  confidence         Float       @default(1.0)
  cwe                String?
  affectedComponent  String?
  evidence           String?
  affectedFiles      String      @default("[]")
  affectedCode       String?
  regressionRisk     String?
  risk               String?
  remediation        String?
  reproductionSteps  String      @default("[]")
  references         String      @default("[]")
  fixApproved        Boolean     @default(false)
  fixAppliedAt       DateTime?
  verificationRunId  String?
  fixHistory         String      @default("[]")
  rawLogExcerpt      String?
  testRun            TestRun?    @relation(fields: [testRunId], references: [id], onDelete: SetNull)
  testResult         TestResult? @relation(fields: [testResultId], references: [id], onDelete: SetNull)
  project            Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([projectId, status, severity])
}

model SelfHealLog {
  id                 String      @id @default(cuid())
  testCaseId         String
  testResultId       String?
  findingId          String?
  originalValue      String?
  healedValue        String?
  originalTarget     String      @default("")
  healedTarget       String      @default("")
  healType           String      @default("SELECTOR_UPDATE")
  confidence         Float       @default(1.0)
  status             String      @default("APPLIED")
  verificationStatus String      @default("VERIFIED")
  appliedAt          DateTime    @default(now())
  testCase           TestCase    @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  testResult         TestResult? @relation(fields: [testResultId], references: [id], onDelete: SetNull)
  createdAt          DateTime    @default(now())
}

model Artifact {
  id           String      @id @default(cuid())
  testRunId    String
  testResultId String?
  type         String
  fileName     String
  fileSize     Int
  mimeType     String
  storageKey   String
  storageUrl   String?
  metadata     String      @default("{}")
  testRun      TestRun     @relation(fields: [testRunId], references: [id], onDelete: Cascade)
  testResult   TestResult? @relation(fields: [testResultId], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())
}

model ApiKey {
  id             String        @id @default(cuid())
  organizationId String
  projectId      String?
  userId         String
  name           String
  keyPrefix      String
  hashedKey      String        @unique
  scope          String        @default("ALL")
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  revokedAt      DateTime?
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  mcpSessions    McpSession[]
  createdAt      DateTime      @default(now())
}

model McpSession {
  id            String   @id @default(cuid())
  apiKeyId      String
  clientName    String
  clientVersion String?
  lastActiveAt  DateTime @default(now())
  ipAddress     String?
  apiKey        ApiKey   @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
}

model AuditLog {
  id             String        @id @default(cuid())
  organizationId String?
  userId         String?
  action         String
  resourceType   String
  resourceId     String
  payload        String        @default("{}")
  ipAddress      String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
}

// ============================================================================
// SaaS BILLING ARCHITECTURE MODELS
// ============================================================================

model Plan {
  id            String         @id @default(cuid())
  slug          String         @unique // FREE, STARTER, PRO, TEAM, BUSINESS, ENTERPRISE
  name          String
  description   String?
  priceMonthly  Int            @default(0) // In cents (e.g. 2900 = $29.00)
  priceYearly   Int            @default(0) // In cents (e.g. 29000 = $290.00)
  currency      String         @default("USD")
  isActive      Boolean        @default(true)
  limits        String         @default("{}") // JSON: maxProjects, maxExecutions, maxAiTokens, etc.
  features      Feature[]
  subscriptions Subscription[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Feature {
  id          String   @id @default(cuid())
  planId      String
  code        String   // PARALLEL_SANDBOXES, SELF_HEALING, DEFENSIVE_SECURITY, MCP_SERVER, EMULATOR_WORKERS
  name        String
  description String?
  isEnabled   Boolean  @default(true)
  plan        Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([planId, code])
}

model Subscription {
  id                   String        @id @default(cuid())
  organizationId       String        @unique
  planId               String
  status               String        @default("active") // trial, active, past_due, cancelled, expired
  interval             String        @default("monthly") // monthly, yearly
  currentPeriodStart   DateTime      @default(now())
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean       @default(false)
  trialEndsAt          DateTime?
  stripeCustomerId     String?
  stripeSubscriptionId String?
  organization         Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan                 Plan          @relation(fields: [planId], references: [id])
  invoices             Invoice[]
  transactions         Transaction[]
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
}

model UsageMetric {
  id                     String       @id @default(cuid())
  organizationId         String
  monthYear              String       // e.g. "2026-08"
  projectsCount          Int          @default(0)
  testExecutionsCount    Int          @default(0)
  aiTokensCount          Int          @default(0)
  browserMinutes         Int          @default(0)
  apiRequestsCount       Int          @default(0)
  mobileExecutionMinutes Int          @default(0)
  storageBytes           BigInt       @default(0)
  artifactsCount         Int          @default(0)
  teamMembersCount       Int          @default(0)
  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  @@unique([organizationId, monthYear])
}

model Invoice {
  id                String        @id @default(cuid())
  organizationId    String
  subscriptionId    String?
  invoiceNumber     String        @unique // e.g. "INV-2026-001"
  amountDue         Int           @default(0) // in cents
  amountPaid        Int           @default(0) // in cents
  currency          String        @default("USD")
  status            String        @default("PAID") // DRAFT, OPEN, PAID, VOID, UNCOLLECTIBLE
  dueDate           DateTime
  paidAt            DateTime?
  hostedInvoiceUrl  String?
  pdfUrl            String?
  lineItems         String        @default("[]") // JSON array of { description, amount, quantity }
  organization      Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription      Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  payments          Payment[]
  transactions      Transaction[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model Payment {
  id                  String         @id @default(cuid())
  organizationId      String
  invoiceId           String?
  paymentMethodId     String?
  merchantReference   String?        @unique
  paymobIntentionId   String?
  paymobTransactionId String?
  clientSecret        String?
  checkoutUrl         String?
  amount              Int            @default(0) // in cents / smallest currency unit
  currency            String         @default("USD")
  status              String         @default("PENDING") // PENDING, SUCCEEDED, FAILED, CANCELLED, EXPIRED, REFUNDED, VOIDED
  targetPlanSlug      String?
  targetInterval      String?        @default("monthly")
  rawWebhookPayload   String?        @default("{}")
  verificationResult  String?        @default("{}")
  reconciledAt        DateTime?
  errorMessage        String?
  organization        Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice             Invoice?       @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  paymentMethod       PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  refunds             Refund[]
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @default(now()) @updatedAt
}

model PaymentMethod {
  id             String       @id @default(cuid())
  organizationId String
  type           String       @default("CARD") // CARD, BANK_TRANSFER, PAYPAL
  provider       String       @default("STRIPE")
  last4          String
  brand          String       @default("visa") // visa, mastercard, amex
  expMonth       Int
  expYear        Int
  isDefault      Boolean      @default(false)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payments       Payment[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Transaction {
  id             String        @id @default(cuid())
  organizationId String
  subscriptionId String?
  invoiceId      String?
  type           String        @default("CHARGE") // CHARGE, PAYMENT, CREDIT, REFUND
  amount         Int           @default(0) // in cents
  currency       String        @default("USD")
  status         String        @default("COMPLETED")
  description    String?
  referenceId    String?
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  invoice        Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
}

model Credit {
  id               String       @id @default(cuid())
  organizationId   String
  amount           Int          @default(0) // in cents
  currency         String       @default("USD")
  balanceRemaining Int          @default(0) // in cents
  reason           String?
  expiresAt        DateTime?
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model Refund {
  id             String       @id @default(cuid())
  organizationId String
  paymentId      String?
  amount         Int          @default(0) // in cents
  currency       String       @default("USD")
  reason         String?
  status         String       @default("SUCCEEDED") // PENDING, SUCCEEDED, FAILED
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payment        Payment?     @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
}

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique // e.g. "AI_SELF_HEALING", "MOBILE_EMULATORS", "DAST_SCANNER", "PARALLEL_EXECUTION"
  name        String
  description String?
  isEnabled   Boolean  @default(true)
  rules       String   @default("{}") // JSON rules for targeting
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
}

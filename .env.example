# ==============================================================================
# NovaQA Platform - Environment Configuration
# ==============================================================================

# Server & Network
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
MCP_PORT=4001

# PostgreSQL Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/novaqa?schema=public"

# Redis Cache & Queue
REDIS_URL="redis://localhost:6379"

# Object Storage (MinIO / AWS S3)
STORAGE_PROVIDER=local # 'local' or 's3'
STORAGE_LOCAL_PATH="./data/artifacts"
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET_NAME="novaqa-artifacts"
S3_FORCE_PATH_STYLE=true

# Security & Authentication
JWT_SECRET="novaqa-super-secret-jwt-key-change-in-production-min-32-chars-long"
JWT_EXPIRES_IN="7d"
API_KEY_SALT="novaqa-secret-api-key-salt"

# AI Provider Configuration (OpenAI, Anthropic, Gemini, or Mock)
AI_DEFAULT_PROVIDER="mock" # 'openai' | 'anthropic' | 'gemini' | 'mock'
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-pro"

# Test Execution Sandboxes
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT_MS=30000
MAX_CONCURRENT_RUNS=5

# Logging
LOG_LEVEL="info"

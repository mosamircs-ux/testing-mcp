# ============================================================================
# Stage 1: Build & Prune Monorepo
# ============================================================================
FROM node:20-alpine AS builder
WORKDIR /app

# Install dependencies needed for native modules
RUN apk add --no-cache libc6-compat python3 make g++

# Copy root manifests and workspace files
COPY package*.json ./
COPY packages/ ./packages/
COPY apps/ ./apps/
COPY tsconfig.base.json ./
COPY tsconfig.base.json ./tsconfig.json

# Install dependencies across all packages
RUN npm install

# Generate Prisma Client
RUN npx prisma generate --schema=packages/database/prisma/schema.prisma

# Build TypeScript packages
RUN npm run --workspace=@novaqa/types build --if-present
RUN npm run --workspace=@novaqa/shared build --if-present
RUN npm run --workspace=@novaqa/database build --if-present
RUN npm run --workspace=@novaqa/auth build --if-present
RUN npm run --workspace=@novaqa/security build --if-present
RUN npm run --workspace=@novaqa/reporting build --if-present
RUN npm run --workspace=@novaqa/test-runner build --if-present
RUN npm run --workspace=@novaqa/worker build --if-present
RUN npm run --workspace=@novaqa/ai build --if-present
RUN npm run --workspace=@novaqa/api build --if-present

# ============================================================================
# Stage 2: Production Runner
# ============================================================================
FROM node:20-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=4000

# Create non-root system user for security
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 novaqa

# Copy runtime artifacts from builder
COPY --from=builder /app/package*.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages ./packages
COPY --from=builder /app/apps/api ./apps/api

# Fix ownership
RUN chown -R novaqa:nodejs /app

USER novaqa

EXPOSE 4000

# Health check
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:4000/health || exit 1

CMD ["node", "apps/api/dist/index.js"]

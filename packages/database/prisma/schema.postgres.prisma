datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  OWNER
  ADMIN
  ENGINEER
  VIEWER
}

enum SubscriptionTier {
  FREE
  PRO
  ENTERPRISE
}

enum ProjectCategory {
  WEB
  REST_API
  GRAPHQL_API
  BACKEND_SERVICE
  ADMIN_DASHBOARD
  SAAS
  ECOMMERCE
  ERP
  CRM
  FINTECH
  HEALTHCARE
  MOBILE_ANDROID
  MOBILE_IOS
  MOBILE_REACT_NATIVE
  MOBILE_FLUTTER
  MICROSERVICE
  FULLSTACK
}

enum EngineType {
  PLAYWRIGHT
  API_REST
  API_GRAPHQL
  MOBILE_HARNESS
}

enum TestRunStatus {
  PENDING
  QUEUED
  RUNNING
  PASSED
  FAILED
  CANCELLED
  TIMED_OUT
}

enum TestResultStatus {
  PASSED
  FAILED
  SKIPPED
  FLAKY
  TIMED_OUT
}

enum FindingSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

enum FindingCategory {
  BUG
  FLAKY_TEST
  REGRESSION
  SPEC_DRIFT
  PERFORMANCE
  SECURITY
}

enum FindingStatus {
  OPEN
  TRIAGED
  AUTO_HEALED
  RESOLVED
  IGNORED
}

enum ArtifactType {
  SCREENSHOT
  VIDEO
  DOM_SNAPSHOT
  NETWORK_HAR
  CONSOLE_LOG
  EXECUTION_TRACE
  API_RESPONSE
}

model User {
  id           String               @id @default(cuid())
  email        String               @unique
  name         String
  passwordHash String
  avatarUrl    String?
  memberships  OrganizationMember[]
  teamMembers  TeamMember[]
  apiKeys      ApiKey[]
  testRuns     TestRun[]
  auditLogs    AuditLog[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
}

model Organization {
  id           String               @id @default(cuid())
  name         String
  slug         String               @unique
  tier         SubscriptionTier     @default(FREE)
  members      OrganizationMember[]
  teams        Team[]
  projects     Project[]
  apiKeys      ApiKey[]
  auditLogs    AuditLog[]
  subscription Subscription?
  usageMetrics UsageMetric[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  role           Role         @default(ENGINEER)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([organizationId, userId])
}

model Team {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  slug           String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members        TeamMember[]
  projects       Project[]
  createdAt      DateTime     @default(now())

  @@unique([organizationId, slug])
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([teamId, userId])
}

model Project {
  id             String          @id @default(cuid())
  organizationId String
  teamId         String?
  name           String
  slug           String
  description    String?
  category       ProjectCategory @default(WEB)
  engineType     EngineType      @default(PLAYWRIGHT)
  repositoryUrl  String?
  baseUrl        String?
  specUrl        String?
  settings       Json            @default("{}")
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  team           Team?           @relation(fields: [teamId], references: [id], onDelete: SetNull)
  environments   Environment[]
  testSuites     TestSuite[]
  testRuns       TestRun[]
  findings       Finding[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([organizationId, slug])
}

model Environment {
  id        String    @id @default(cuid())
  projectId String
  name      String
  slug      String
  baseUrl   String
  variables Json      @default("{}")
  headers   Json      @default("{}")
  isDefault Boolean   @default(false)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  testRuns  TestRun[]
  createdAt DateTime  @default(now())

  @@unique([projectId, slug])
}

model TestSuite {
  id           String     @id @default(cuid())
  projectId    String
  name         String
  description  String?
  tags         String[]   @default([])
  cronSchedule String?
  isActive     Boolean    @default(true)
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  testCases    TestCase[]
  testRuns     TestRun[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model TestCase {
  id              String         @id @default(cuid())
  suiteId         String
  title           String
  description     String?
  category        String         @default("functional")
  priority        String         @default("MEDIUM")
  expectedResult  String
  codeSnippet     String?
  isFlaky         Boolean        @default(false)
  flakinessScore  Float          @default(0.0)
  autoHealEnabled Boolean        @default(true)
  suite           TestSuite      @relation(fields: [suiteId], references: [id], onDelete: Cascade)
  steps           TestCaseStep[]
  results         TestResult[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model TestCaseStep {
  id             String   @id @default(cuid())
  testCaseId     String
  order          Int
  action         String
  target         String?
  value          String?
  description    String
  expectedOutput String?
  testCase       TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@index([testCaseId, order])
}

model TestRun {
  id            String        @id @default(cuid())
  projectId     String
  suiteId       String?
  environmentId String
  triggeredById String?
  triggerSource String        @default("MANUAL")
  status        TestRunStatus @default(PENDING)
  totalTests    Int           @default(0)
  passedTests   Int           @default(0)
  failedTests   Int           @default(0)
  skippedTests  Int           @default(0)
  durationMs    Int           @default(0)
  startedAt     DateTime?
  completedAt   DateTime?
  project       Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  suite         TestSuite?    @relation(fields: [suiteId], references: [id], onDelete: SetNull)
  environment   Environment   @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  triggeredBy   User?         @relation(fields: [triggeredById], references: [id], onDelete: SetNull)
  results       TestResult[]
  artifacts     Artifact[]
  findings      Finding[]
  createdAt     DateTime      @default(now())
}

model TestResult {
  id           String           @id @default(cuid())
  testRunId    String
  testCaseId   String
  status       TestResultStatus @default(PASSED)
  durationMs   Int              @default(0)
  errorMessage String?
  stackTrace   String?
  stepResults  Json             @default("[]")
  startedAt    DateTime         @default(now())
  completedAt  DateTime         @default(now())
  testRun      TestRun          @relation(fields: [testRunId], references: [id], onDelete: Cascade)
  testCase     TestCase         @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  findings     Finding[]
  artifacts    Artifact[]
}

model Finding {
  id                 String          @id @default(cuid())
  testRunId          String
  testResultId       String
  projectId          String
  category           FindingCategory @default(BUG)
  severity           FindingSeverity @default(HIGH)
  status             FindingStatus   @default(OPEN)
  title              String
  description        String
  rootCauseAnalysis  String
  suggestedFix       String?
  suggestedPatch     String?
  autoHealSelector   String?
  rawLogExcerpt      String?
  testRun            TestRun         @relation(fields: [testRunId], references: [id], onDelete: Cascade)
  testResult         TestResult      @relation(fields: [testResultId], references: [id], onDelete: Cascade)
  project            Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
}

model Artifact {
  id           String       @id @default(cuid())
  testRunId    String
  testResultId String?
  type         ArtifactType
  fileName     String
  fileSize     Int
  mimeType     String
  storageKey   String
  storageUrl   String?
  metadata     Json         @default("{}")
  testRun      TestRun      @relation(fields: [testRunId], references: [id], onDelete: Cascade)
  testResult   TestResult?  @relation(fields: [testResultId], references: [id], onDelete: SetNull)
  createdAt    DateTime     @default(now())
}

model ApiKey {
  id             String        @id @default(cuid())
  organizationId String
  userId         String
  name           String
  keyPrefix      String
  hashedKey      String        @unique
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  mcpSessions    McpSession[]
  createdAt      DateTime      @default(now())
}

model McpSession {
  id            String   @id @default(cuid())
  apiKeyId      String
  clientName    String
  clientVersion String?
  lastActiveAt  DateTime @default(now())
  ipAddress     String?
  apiKey        ApiKey   @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
}

model UsageMetric {
  id             String       @id @default(cuid())
  organizationId String
  monthYear      String
  testRunsCount  Int          @default(0)
  aiTokensCount  Int          @default(0)
  storageBytes   BigInt       @default(0)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, monthYear])
}

model Subscription {
  id             String           @id @default(cuid())
  organizationId String           @unique
  tier           SubscriptionTier @default(FREE)
  status         String           @default("active")
  currentPeriodEnd DateTime?
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  userId         String?
  action         String
  resourceType   String
  resourceId     String
  payload        Json         @default("{}")
  ipAddress      String?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
}

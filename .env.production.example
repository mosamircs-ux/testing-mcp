# ============================================================================
# NovaQA Production Environment Configuration Template
# ============================================================================
# IMPORTANT: Never commit actual secret keys or credentials to version control.
# Copy this file to .env.production and populate with vault-generated secrets.

NODE_ENV=production
APP_URL=https://app.novaqa.io
NEXT_PUBLIC_APP_URL=https://app.novaqa.io
NEXT_PUBLIC_API_URL=/api/v1

# ----------------------------------------------------------------------------
# 1. Primary PostgreSQL 16 Database
# ----------------------------------------------------------------------------
POSTGRES_DB=novaqa_production
POSTGRES_USER=novaqa_admin
POSTGRES_PASSWORD=GENERATE_STRONG_RANDOM_PASSWORD_HERE
DATABASE_URL=postgresql://novaqa_admin:${POSTGRES_PASSWORD}@postgres:5432/novaqa_production?schema=public&connection_limit=50&pool_timeout=20

# ----------------------------------------------------------------------------
# 2. Redis 7 In-Memory Cache & Queue
# ----------------------------------------------------------------------------
REDIS_PASSWORD=GENERATE_STRONG_REDIS_PASSWORD_HERE
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0

# ----------------------------------------------------------------------------
# 3. Authentication & Cryptography
# ----------------------------------------------------------------------------
# Generate with: openssl rand -base64 64
JWT_SECRET=GENERATE_SECURE_64_CHAR_JWT_SECRET_HERE
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d

# ----------------------------------------------------------------------------
# 4. S3 / MinIO Object Storage (DOM Snapshots, Video, HAR Logs)
# ----------------------------------------------------------------------------
STORAGE_ENDPOINT=http://minio:9000
STORAGE_BUCKET=novaqa-production-artifacts
STORAGE_ACCESS_KEY=GENERATE_ACCESS_KEY_HERE
STORAGE_SECRET_KEY=GENERATE_SECRET_KEY_HERE
STORAGE_REGION=us-east-1

# ----------------------------------------------------------------------------
# 5. Paymob Unified Payment Gateway
# ----------------------------------------------------------------------------
PAYMOB_API_KEY=sec_live_...
PAYMOB_SECRET_KEY=sec_live_...
PAYMOB_HMAC_SECRET=GENERATE_PAYMOB_HMAC_SHA512_SECRET_HERE
PAYMOB_INTEGRATION_ID_CARD=4129841
PAYMOB_PUBLIC_KEY=pk_live_...

# ----------------------------------------------------------------------------
# 6. AI LLM Model Providers
# ----------------------------------------------------------------------------
AI_DEFAULT_PROVIDER=openai
OPENAI_API_KEY=sk-proj-...
ANTHROPIC_API_KEY=sk-ant-...

# ----------------------------------------------------------------------------
# 7. Execution Worker Pool & Concurrency
# ----------------------------------------------------------------------------
MAX_CONCURRENT_RUNS=16
WORKER_PORT=4001
PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
